# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交

# ===== 大模型（OpenAI 兼容接口，可指向 DeepSeek / Qwen 等）=====
DEEPSEEK_API_KEY=YOUR_API_KEY
BASE_URL=YOUR_BASE_URL
LLM_MODEL=YOUR_MODEL_NAME
LLM_TEMPERATURE=0

# ===== FastAPI 后端 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== LangGraph 持久化 =====
DB_PATH=agent_checkpoints.sqlite
# Critic 连续失败达到该次数后强制终止，防止死循环
MAX_ERROR_COUNT=3

# ===== Playwright 浏览器 / MCP Server =====
# 人机验证需要人工在浏览器窗口中操作，因此这一项必须为 false；
# 设为 true 时遇到 CAPTCHA 只能报错退出，无法等待人工完成。
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
NAV_TIMEOUT_MS=15000
CLICK_TIMEOUT_MS=5000
SCREENSHOT_QUALITY=60

# ===== 人机验证人工介入 =====
# 遇到 CAPTCHA/Cloudflare 挑战时的最长等待时间（毫秒），超时计入一次失败
HUMAN_WAIT_TIMEOUT_MS=180000
# 等待期间轮询页面验证状态的间隔（毫秒）
HUMAN_POLL_INTERVAL_MS=3000
